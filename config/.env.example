# ==========================================================================
# Kirki eCommerce Selenium Test Framework - Environment Configuration
# Copy this file to `.env` and fill in your values. Never commit `.env`.
# ==========================================================================

# --- WordPress environment -------------------------------------------------
# Base URL of the WordPress site (Local by Flywheel default below).
WP_BASE_URL=http://tutorlms.local
# Path prefix for the REST API (default: wp-json).
WP_REST_PREFIX=wp-json

# --- Admin credentials (test site only - never production) -----------------
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# --- Customer credentials (test site only) ---------------------------------
CUSTOMER_USER=customer@example.com
CUSTOMER_PASSWORD=password

# --- Browser / execution ---------------------------------------------------
# Browser to use: chrome or firefox
BROWSER=chrome
# Run headed (false) or headless (true)
HEADLESS=true
# Optional path to the browser binary (leave empty to use the default).
CHROME_BINARY=
FIREFOX_BINARY=
# Explicit wait timeout in seconds for dynamic elements.
EXPLICIT_WAIT=15
# Implicit wait (keep 0 - the framework uses explicit waits only).
IMPLICIT_WAIT=0
# Base interval (seconds) used by polling helpers. Keep small.
POLL_INTERVAL=0.25

# --- Artifacts -------------------------------------------------------------
SCREENSHOT_DIR=screenshots
REPORT_DIR=reports
# Capture browser console logs on failure.
CAPTURE_CONSOLE=true

# --- Direct database access (optional, for verification/cleanup) ----------
# Local by Flywheel runs MySQL on a unix socket. When DB_HOST is a socket
# path, DB_PORT is ignored.
# To use a TCP connection instead, set DB_HOST=127.0.0.1 and DB_PORT=3306
# (Local only exposes the socket by default).
DB_HOST=/Users/rashed/Library/Application Support/Local/run/AOBwRjoLd/mysql/mysqld.sock
DB_PORT=3306
DB_NAME=local
DB_USER=root
DB_PASSWORD=root

# --- Optional: WP-CLI (used when available for setup tasks) ----------------
# Leave empty to auto-detect `wp` in PATH.
WP_CLI_PATH=

# --- Optional: PayPal sandbox (payment tests) ------------------------------
# Only needed for the PayPal sandbox payment step. Leave empty to skip
# PayPal-specific assertions. Use SANDBOX test credentials only.
PAYPAL_SANDBOX_EMAIL=
PAYPAL_SANDBOX_PASSWORD=

# --- Test data -------------------------------------------------------------
# Prefix for all test-created entities (products, coupons, customers...).
TEST_DATA_PREFIX=KECOM_TEST
